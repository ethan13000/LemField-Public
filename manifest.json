{
  "manifest_version": 3,
  "name": "LemField",
  "version": "1.1.0",
  "description": "Independent Moxfield companion: deck requirements, card discovery, printing tools, and duplex-ready card sheets.",
  "browser_specific_settings": {
    "gecko": {
      "id": "moxfield-requirements@local.extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "searchTerms",
          "authenticationInfo",
          "browsingActivity"
        ],
        "optional": [
          "technicalAndInteraction"
        ]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.moxfield.com/*",
    "https://moxfield.com/*",
    "https://www.moxfield.com/*",
    "https://api2.moxfield.com/*",
    "https://json.edhrec.com/*",
    "https://edhrec.com/*",
    "https://api.scryfall.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://moxfield.com/*",
        "https://www.moxfield.com/*"
      ],
      "js": [
        "duplicates.js",
        "deck-selection-model.js",
        "deck-bulk.js",
        "deck-bridge.js",
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://moxfield.com/*",
        "https://www.moxfield.com/*"
      ],
      "js": [
        "browser-compat.js",
        "rules.js",
        "dashboard-style.js",
        "edhrec-data.js",
        "duplicates.js",
        "deck-client.js",
        "deck-selection-model.js",
        "deck-selection.js",
        "deck-duplicates.js",
        "deck-list-counts.js",
        "basic-lands.js",
        "search-add.js",
        "deck-print.js",
        "card-search.js",
        "print-preferences.js",
        "role-search.js",
        "image-loader.js",
        "edhrec.js",
        "printing-shortcuts.js",
        "deck-search-filter.js",
        "content.js",
        "feature-ui.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://scryfall.com/card/*",
        "https://www.scryfall.com/card/*"
      ],
      "js": [
        "browser-compat.js",
        "scryfall-add.js",
        "feature-ui.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "LemField",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": [
      "safe-response.js",
      "print-sync.js",
      "edhrec-data.js",
      "card-search.js",
      "art-background.js",
      "similar-background.js",
      "background.js"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard.css"
      ],
      "matches": [
        "https://moxfield.com/*",
        "https://www.moxfield.com/*"
      ]
    }
  ],
  "incognito": "not_allowed",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
